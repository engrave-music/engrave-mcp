  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Enter one or more musical lanes together in an atomic edit.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "document": {
          "maxLength": 128,
          "type": "string"
        },
        "excerpt": {
          "maxLength": 32,
          "type": "string"
        },
        "expected_revision": {
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "lanes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "events": {
                "description": "Give each lane an events array. A note, chord or rest has pitches (C through B, up to three # or b accidentals, then octave, e.g. Eb4 or C###4) or drums (MIDI keys 0 through 127). An empty pitches or drums array enters a rest. The duration is an exact whole-note fraction such as 1/4 or 3/8 and defaults to 1/4 for main events. Use tie: true for a whole chord or give an array of its tied pitches or drum keys. Use {\"tuplet\":\"3:2\",\"events\":[...]} for an actual:normal group of notes, chords or rests, and {\"bar\":true} to check a measure boundary. Attach grace_before or grace_after arrays to a main chord, with each grace specifying kind, pitches or drums, and optional duration. Before-grace kinds are acciac, appog, grace4, grace16, grace32. After-grace kinds are after8, after16, after32. Omitted grace durations are 1/8 for acciac, appog and after8, 1/4 for grace4, 1/16 for grace16 and after16, and 1/32 for grace32 and after32.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "bar": {
                      "type": "boolean"
                    },
                    "drums": {
                      "items": {
                        "maximum": 127,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "type": "array"
                    },
                    "duration": {
                      "maxLength": 4096,
                      "type": "string"
                    },
                    "events": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
