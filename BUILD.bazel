load("@engrave//bazel:defs.bzl", "cc_pch", "pch_consumer_copts", "staged_binary_group", "win_manifest_library")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["engrave_mcp/utf8.manifest"])

HOST_DEFINES = select({
    "@platforms//os:windows": [
        "WIN32",
        "NOMINMAX",
        "WIN32_LEAN_AND_MEAN",
        "NOGDI",
        "_USE_MATH_DEFINES",
        "_UNICODE",
        "UNICODE",
        "_WIN32_WINNT=0x0A00",
    ],
    "//conditions:default": [],
}) + select({
    "@engrave//bazel:windows_msvc": ["_MT"],
    "//conditions:default": [],
})

HOST_COPTS = [
    "-Wno-deprecated-declarations",
] + select({
    "@engrave//bazel:windows_msvc": [
        "-fstrict-aliasing",
        "-fno-wrapv",
    ],
    "//conditions:default": [],
}) + select({
    # ASan's dynamic stack alloca disables Win64 reserved call frames, causing LLVM to emit
    # dynamic `subq $0x20, %rsp` before calls inside WinEH catch$ funclets and corrupting
    # RtlVirtualUnwind establisher frame lookup on rethrow.
    "@engrave//bazel:asan_msvc": [
        "-mllvm",
        "-asan-stack-dynamic-alloca=0",
    ],
    "//conditions:default": [],
}) + select({
    # Under MSVC ABI, empty secondary base std::codecvt_base sits at the end of
    # libc++'s std::codecvt with zero tail bytes, tripping UBSan object-size in fs::u8path.
    "@engrave//bazel:ubsan_msvc": ["-fno-sanitize=object-size"],
    "//conditions:default": [],
}) + select({
    "@platforms//os:windows": [],
    "//conditions:default": [
        "-fPIC",
        "-pthread",
    ],
})

HOST_PCH_INPUTS = select({
    "@engrave//bazel:pch_enabled": [
        ":host_pch",
        "//bazel:pch/host_pch.h",
    ],
    "//conditions:default": [],
})

HOST_PCH_COPTS = HOST_COPTS + select({
    "@engrave//bazel:pch_enabled": pch_consumer_copts(":host_pch"),
    "//conditions:default": [],
})

HOST_LINKOPTS = select({
    "@engrave//bazel:windows_msvc": ["-Wl,/STACK:16777216"],
    "//conditions:default": ["-pthread"],
}) + select({
    "@engrave//bazel:opt_msvc_gc": ["-Wl,/OPT:SAFEICF"],
    "@engrave//bazel:opt_linux_gc": ["-Wl,--icf=safe"],
    "//conditions:default": [],
})

win_manifest_library(
    name = "utf8_manifest",
    manifest = "engrave_mcp/utf8.manifest",
)

WIN_MANIFEST_DEPS = select({
    "@platforms//os:windows": [":utf8_manifest"],
    "//conditions:default": [],
})

cc_library(
    name = "host_defines",
    defines = HOST_DEFINES,
)

cc_library(
    name = "host_headers",
    hdrs = glob(["engrave_mcp/*.h"]),
    includes = ["engrave_mcp"],
    deps = [
        ":host_defines",
        "@gtl",
    ],
)

cc_pch(
    name = "host_pch",
    copts = HOST_COPTS,
    header = "//bazel:pch/host_pch.h",
    deps = [
        ":host_defines",
        "@glaze",
        "@gtl",
        "@unordered_dense",
    ],
)

cc_library(
    name = "tool_registry",
    srcs = [
        "engrave_mcp/json.cpp",
        "engrave_mcp/registry.cpp",
        "engrave_mcp/schema_defs.cpp",
    ],
    additional_compiler_inputs = HOST_PCH_INPUTS,
    copts = HOST_PCH_COPTS,
    deps = [
        ":host_headers",
        "@amc",
        "@engrave//:public_headers",
        "@glaze",
        "@unordered_dense",
    ],
)

cc_library(
    name = "document_store",
    srcs = [
        "engrave_mcp/api_edit_json.cpp",
        "engrave_mcp/arguments.cpp",
        "engrave_mcp/phrase.cpp",
        "engrave_mcp/music_window.cpp",
        "engrave_mcp/api_json.cpp",
        "engrave_mcp/host_api.cpp",
    ],
    additional_compiler_inputs = HOST_PCH_INPUTS,
    copts = HOST_PCH_COPTS,
    deps = [
        ":host_headers",
        ":tool_registry",
        "@amc",
        "@engrave",
        "@glaze",
        "@unordered_dense",
    ],
)

cc_binary(
    name = "registry_dump",
    srcs = ["engrave_mcp/tools/registry_dump.cpp"],
    additional_compiler_inputs = HOST_PCH_INPUTS,
    copts = HOST_PCH_COPTS,
    linkopts = HOST_LINKOPTS,
    deps = [":tool_registry"],
)

cc_binary(
    name = "registry_test",
    srcs = ["engrave_mcp/tests/registry_test.cpp"],
    additional_compiler_inputs = HOST_PCH_INPUTS,
    copts = HOST_PCH_COPTS,
    linkopts = HOST_LINKOPTS,
    deps = [
        ":tool_registry",
        "@gtest",
    ],
)

cc_library(
    name = "host_publication",
    srcs = ["engrave_mcp/publication.cpp"],
    copts = HOST_COPTS,
    linkopts = select({
        "@engrave//bazel:windows_msvc": ["-Wl,advapi32.lib"],
        "//conditions:default": [],
    }),
    deps = [
        ":host_headers",
        "@amc",
        "@unordered_dense",
    ],
)

cc_library(
    name = "engrave_mcp_core",
    srcs = [
        "engrave_mcp/api_output.cpp",
        "engrave_mcp/async_session.cpp",
        "engrave_mcp/mcp_transport.cpp",
        "engrave_mcp/server_main.cpp",
    ],
    additional_compiler_inputs = HOST_PCH_INPUTS,
    copts = HOST_PCH_COPTS,
    linkopts = HOST_LINKOPTS + select({
        "@engrave//bazel:windows_msvc": [
            "-Wl,ws2_32.lib",
            "-Wl,mswsock.lib",
        ],
        "//conditions:default": [],
    }),
    deps = [
        ":document_store",
        ":host_headers",
        ":host_publication",
        "@amc",
        "@asio",
        "@dyn",
        "@glaze",
        "@unordered_dense",
    ],
)

cc_binary(
    name = "engrave-mcp",
    srcs = ["engrave_mcp/main.cpp"],
    additional_compiler_inputs = HOST_PCH_INPUTS,
    copts = HOST_PCH_COPTS,
    linkopts = HOST_LINKOPTS,
    deps = [":engrave_mcp_core"] + WIN_MANIFEST_DEPS,
)

alias(
    name = "engrave_mcp",
    actual = ":engrave-mcp",
)

cc_binary(
    name = "engrave-mcp-test",
    srcs = ["engrave_mcp/tests/main_test.cpp"],
    additional_compiler_inputs = HOST_PCH_INPUTS,
    copts = HOST_PCH_COPTS,
    linkopts = HOST_LINKOPTS,
    deps = [":engrave_mcp_core"] + WIN_MANIFEST_DEPS,
)

alias(
    name = "engrave_mcp_test",
    actual = ":engrave-mcp-test",
)

cc_binary(
    name = "host_api_test",
    srcs = ["engrave_mcp/tests/host_api_test.cpp"],
    additional_compiler_inputs = HOST_PCH_INPUTS,
    copts = HOST_PCH_COPTS,
    linkopts = HOST_LINKOPTS,
    deps = [
        ":engrave_mcp_core",
        "@glaze",
        "@gtest",
    ] + WIN_MANIFEST_DEPS,
)

cc_binary(
    name = "live_export_test",
    srcs = ["engrave_mcp/tests/live_export_test.cpp"],
    additional_compiler_inputs = HOST_PCH_INPUTS,
    copts = HOST_PCH_COPTS,
    linkopts = HOST_LINKOPTS,
    deps = [
        ":engrave_mcp_core",
        "@glaze",
    ] + WIN_MANIFEST_DEPS,
)

cc_binary(
    name = "staging_test",
    srcs = ["engrave_mcp/tests/staging_test.cpp"],
    copts = HOST_COPTS,
    linkopts = HOST_LINKOPTS,
    deps = [
        ":host_publication",
        "@gtest",
    ],
)

cc_binary(
    name = "publication_test",
    srcs = ["engrave_mcp/tests/publication_test.cpp"],
    copts = HOST_COPTS,
    linkopts = HOST_LINKOPTS + ["-Wl,--wrap=fsync"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":host_publication",
        "@gtest",
    ],
)

staged_binary_group(
    name = "host_binaries",
    srcs = [
        ":engrave-mcp",
        ":engrave-mcp-test",
        ":host_api_test",
        ":live_export_test",
        ":registry_dump",
        ":registry_test",
        ":staging_test",
    ] + select({
        "@platforms//os:linux": [":publication_test"],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "all_binaries",
    srcs = [
        ":host_binaries",
        "@engrave//:engine_tests",
    ],
)
